+/* 
+ * Function that makes a temporary file
+ * Return values:
+ *   0 = Everything went well
+ *   5 = Buffer could not be allocated
+ *   15 = Temporary file could not be created
+ */
+static int maketempfile(){
+	/* Variable Declarations */
+	INT32 tmpnum;
+	int freeint1;
+	
+	/* Allocates tmpfilepath */
+	tmpfilepath=NULL;
+	tmpfilepath=malloc(8);
+	if (tmpfilepath==NULL) return 5;
+	memset(tmpfilepath,0,8);
+	
+	/* Makes temporary file */
+	for (tmpnum=0;tmpnum<4096;++tmpnum){
+		tmp=NULL;
+		inttostring(tmpfilepath,tmpnum,16,3);
+		memset(tmpfilepath+3,'.',1);
+		memset(tmpfilepath+4,'$',1);
+		memset(tmpfilepath+5,'$',1);
+		memset(tmpfilepath+6,'$',1);
+		memset(tmpfilepath+7,0,1);
+		tmp=fopen(tmpfilepath,"rb");
+		if (tmp!=NULL){
+			freeint1=fclose(tmp);
+			if (freeint1!=0) return 15;
+			continue;
+		}else{
+			tmp=fopen(tmpfilepath,"w+b");
+			if (tmp!=NULL) break;
+		}
+	}
+	
+	/* Checks whether temporary file has been opened */
+	if (tmp==NULL) return 15;
+	
+	return 0;
+}
+
+/* 
+ * Function that destroys a temporary file
+ * Return values:
+ *   0 = Everything went well
+ *  17 = Temporary file could not be written to
+ */
+static int destroytempfile(){
+	/* Variable Declarations */
+	int freeint1;
+	
+	/* Closes tmp */
+	freeint1=fclose(tmp);
+	if (freeint1!=0) return 17;
+	
+	freeint1=remove(tmpfilepath);
+	if (freeint1!=0) return 17;
+	
+	return 0;
+}
